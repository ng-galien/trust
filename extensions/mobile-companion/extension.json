{
  "contract": "trust.extension@1",
  "id": "mobile-companion",
  "title": "Mobile companion",
  "version": "0.1.0",
  "server": "./bundle/server.mjs",
  "configuration": {
    "databasePath": {
      "type": "string"
    },
    "databaseUrl": {
      "type": "string"
    },
    "pushSubject": {
      "type": "string"
    },
    "pushAllowedOrigins": {
      "type": "string"
    }
  },
  "requestedCapabilities": [
    "plans.read",
    "plans.subscribe"
  ],
  "mcp": {
    "description": "Manage the mobile project catalog and structured interaction feed. Submitted answers remain external observations; they never qualify TRUST Checks.",
    "commands": [
      {
        "name": "projects.list",
        "description": "List registered mobile project entries and routes.",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        }
      },
      {
        "name": "projects.put",
        "description": "Register or update one mobile project entry with its status and route.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "status"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "paused",
                "unavailable"
              ]
            },
            "route": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "subjects.list",
        "description": "List durable subjects and explicit source links for one project.",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project"
          ],
          "properties": {
            "project": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "subjects.read",
        "description": "Read one durable subject, its revision and provenance for each typed link.",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "subjects.put",
        "description": "Create or replace one subject and its explicit typed links at an expected revision; validates each target against its source item.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "project",
            "title",
            "description",
            "expectedRevision",
            "links"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "project": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0
            },
            "links": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "relation",
                  "description",
                  "item",
                  "targetIdentity",
                  "provenance"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "article",
                      "document",
                      "plan",
                      "decision"
                    ]
                  },
                  "relation": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "item": {
                    "type": "string"
                  },
                  "targetIdentity": {
                    "type": "string"
                  },
                  "provenance": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      {
        "name": "conversations.list",
        "description": "List conversation view states in pinned order; deleted conversations are omitted unless requested.",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "includeDeleted": {
              "type": "boolean"
            }
          }
        }
      },
      {
        "name": "conversations.pin",
        "description": "Set the pinned flag for one active conversation without changing its project or feed.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project",
            "pinned"
          ],
          "properties": {
            "project": {
              "type": "string"
            },
            "pinned": {
              "type": "boolean"
            }
          }
        }
      },
      {
        "name": "conversations.delete",
        "description": "Hide one conversation from the active list with a reversible tombstone; keep its project and feed.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project"
          ],
          "properties": {
            "project": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "conversations.restore",
        "description": "Restore one tombstoned conversation to the active list.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project"
          ],
          "properties": {
            "project": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "articles.read",
        "description": "Read the current or one historical version of a stable Markdown article, including version history.",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item"
          ],
          "properties": {
            "item": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      {
        "name": "articles.revise",
        "description": "Append a new immutable version to one article ID with author, reason and optimistic version check. Exactly one raw Markdown or template-data source is required.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item",
            "expectedVersion",
            "title",
            "summary",
            "author",
            "reason"
          ],
          "properties": {
            "item": {
              "type": "string"
            },
            "expectedVersion": {
              "type": "integer",
              "minimum": 1
            },
            "title": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "templateId": {
              "type": "string"
            },
            "templateVersion": {
              "type": "integer",
              "minimum": 1
            },
            "data": {
              "type": "object"
            },
            "author": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "articles.consolidate",
        "description": "Import existing immutable explanation items as historical versions of one article ID and hide their duplicate feed cards. Their original rows remain stored.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "article",
            "aliases"
          ],
          "properties": {
            "article": {
              "type": "string"
            },
            "aliases": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      {
        "name": "templates.put",
        "description": "Publish one immutable, versioned Liquid Markdown template with a closed JSON data schema. Identical retries are safe.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "title",
            "source",
            "dataSchema"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "title": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "dataSchema": {
              "type": "object"
            }
          }
        }
      },
      {
        "name": "templates.read",
        "description": "Read one exact immutable post template version and its data schema.",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      {
        "name": "templates.list",
        "description": "List up to 100 published post template versions.",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        }
      },
      {
        "name": "posts.publish",
        "description": "Publish a structured-data post using one immutable template version. The rendered Markdown is frozen. A revision must use a new item ID and may identify the prior item with supersedes.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "project",
            "kind",
            "title",
            "summary",
            "templateId",
            "templateVersion",
            "data"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "project": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "progress",
                "explanation"
              ]
            },
            "title": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "templateId": {
              "type": "string"
            },
            "templateVersion": {
              "type": "integer",
              "minimum": 1
            },
            "data": {
              "type": "object"
            },
            "supersedes": {
              "type": "string"
            },
            "plan": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "posts.read",
        "description": "Read one raw or templated post, including its source mode, frozen Markdown, template provenance and structured data when present.",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item"
          ],
          "properties": {
            "item": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "feed.publish",
        "description": "Append a structured mobile feed item. Repeating an identical identifier is safe; changing it is refused.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "project",
            "kind",
            "title",
            "summary",
            "body"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "project": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "progress",
                "explanation",
                "question",
                "decision",
                "confirmation",
                "review",
                "document"
              ]
            },
            "title": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "documentUrl": {
              "type": "string"
            },
            "form": {
              "type": "object"
            },
            "plan": {
              "type": "string"
            },
            "supersedes": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "feed.list",
        "description": "Read a bounded chronological mobile feed, optionally for one project.",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project": {
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "before": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "items.read",
        "description": "Read a full mobile item and its submitted answer if present.",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item"
          ],
          "properties": {
            "item": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      {
        "name": "responses.read",
        "description": "Read the durable typed response by stable item/form ID, including form and response revisions. A procedure may read the same data over the extension HTTP API.",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item"
          ],
          "properties": {
            "item": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "responses.submit",
        "description": "Submit one validated, durable answer to a form at expected revision zero. Identical retries are safe; conflicting replies are refused. Does not qualify a TRUST Check.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item",
            "expectedRevision",
            "answers"
          ],
          "properties": {
            "item": {
              "type": "string"
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0
            },
            "answers": {
              "type": "object"
            }
          }
        }
      },
      {
        "name": "notifications.status",
        "description": "Read Web Push availability, the public VAPID key and the count of pending deliveries; no endpoint or private key is returned.",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        }
      },
      {
        "name": "notifications.subscribe",
        "description": "Register one browser Web Push endpoint for future feed notifications.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint"
          ],
          "properties": {
            "endpoint": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "notifications.unsubscribe",
        "description": "Disable one browser Web Push endpoint and cancel pending deliveries.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint"
          ],
          "properties": {
            "endpoint": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "client.report",
        "description": "Record one bounded, non-sensitive mobile client boot diagnostic.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage",
            "code",
            "platform",
            "session"
          ],
          "properties": {
            "stage": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "platform": {
              "type": "string"
            },
            "session": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "diagnostics.read",
        "description": "Read recent bounded mobile client boot diagnostics without answers or browser URLs.",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        }
      }
    ]
  },
  "ui": {
    "name": "trust_mobile_companion",
    "entry": "remoteEntry.js",
    "module": "./Page",
    "assets": "./dist"
  }
}
