{
  "contract": "trust.extension@1",
  "id": "coordination",
  "title": "Agent coordination",
  "version": "1.0.0",
  "server": "./bundle/server.mjs",
  "configuration": {
    "databaseUrl": { "type": "string", "required": true }
  },
  "requestedCapabilities": ["plans.read", "plans.subscribe"],
  "mcp": {
    "description": "Inspect coordination missions and edit their organizational tags. Mission execution and Plan qualification remain governed by TRUST Checks.",
    "commands": [
      {
        "name": "missions.suggest",
        "description": "Suggest distinct project, assignee or coordination tag values from all matching missions. Query is a literal case-insensitive substring. Results are bounded and sorted; hasMore invites refinement. Other mission filters apply before suggestions; omit the edited field filter when changing that facet. Plan labels and Procedures use separately authorized Plan reads.",
        "readOnly": true,
        "inputSchema": {
          "type": "object", "additionalProperties": false, "required": ["field"],
          "properties": {
            "field": { "type": "string", "enum": ["project", "assignee", "tags"] },
            "query": { "type": "string", "maxLength": 1024 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 10 },
            "search": { "type": "string", "maxLength": 1024 },
            "state": { "type": "string", "enum": ["pending", "claimed", "blocked", "completed"] },
            "project": { "type": "string", "maxLength": 1024 },
            "assignee": { "type": "string", "maxLength": 1024 },
            "tags": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
          }
        }
      },
      {
        "name": "missions.list",
        "description": "List real missions with filters and pagination. All tags must match; Plan labels and Procedure filtering use separately authorized Plan reads.",
        "readOnly": true,
        "inputSchema": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
            "offset": { "type": "integer", "minimum": 0 },
            "search": { "type": "string", "maxLength": 1024 },
            "state": { "type": "string", "enum": ["pending", "claimed", "blocked", "completed"] },
            "project": { "type": "string", "maxLength": 1024 },
            "assignee": { "type": "string", "maxLength": 1024 },
            "tags": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
          }
        }
      },
      {
        "name": "tags.replace",
        "description": "Replace a mission's editable coordination tags using its current tagRevision. Does not modify Plan labels, mission request, response or execution state.",
        "readOnly": false,
        "inputSchema": {
          "type": "object", "additionalProperties": false, "required": ["mission", "expectedRevision", "tags"],
          "properties": {
            "mission": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 2147483646 },
            "tags": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
          }
        }
      }
    ]
  },
  "ui": {
    "name": "trust_coordination",
    "entry": "remoteEntry.js",
    "module": "./Page",
    "assets": "./dist"
  }
}
