{
  "name": "@trust/gherkin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./src/format.ts",
      "import": "./dist/format.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "test:acceptance": "npm run build && vitest run acceptance",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.acceptance.json"
  },
  "dependencies": {
    "@cucumber/gherkin": "^41.0.0",
    "@cucumber/messages": "^31.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
