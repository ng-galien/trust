{
  "contract": "trust.compiled-operation@1",
  "operation": "file.license-read",
  "version": "1.0.0",
  "title": "Read license text",
  "input": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "environment": {
    "type": "object",
    "properties": {
      "workspaceRoot": {
        "type": "string",
        "format": "trust-directory"
      }
    },
    "required": [
      "workspaceRoot"
    ],
    "additionalProperties": false
  },
  "steps": [
    {
      "name": "license",
      "type": "file-read",
      "file": {
        "relativePath": "LICENSE",
        "root": {
          "environment": "workspaceRoot"
        },
        "format": "text"
      }
    }
  ],
  "produce": {
    "language": "jsonata",
    "expression": "{ \"text\": steps.license.content }"
  },
  "produced": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false
  }
}
