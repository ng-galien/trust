{
  "name": "@trust/extension-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./match": {
      "types": "./dist/match.d.ts",
      "import": "./dist/match.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:acceptance": "npm run build && node --test acceptance/*.acceptance.test.mjs"
  },
  "dependencies": {
    "@trust/operation": "file:../trust-operation",
    "@trust/procedure": "file:../trust-procedure"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
