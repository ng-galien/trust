{
  "name": "@trust/runner",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "package:skill": "node scripts/package-skill.ts",
    "test:acceptance": "npm run build --workspace=@trust/operation && npm run typecheck && vitest run acceptance",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.acceptance.json"
  },
  "dependencies": {
    "@trust/operation": "file:../trust-operation",
    "jsonata": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
