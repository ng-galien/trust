{
  "name": "@trust/runtime",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/src",
    "dist/documentation"
  ],
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && npm run package:documentation",
    "package:documentation": "node scripts/package-documentation.mjs",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest:acceptance": "npm run package:skill --workspace=@trust/runner",
    "test:acceptance": "npm run build && vitest run && node --test dist/acceptance/interface-rules.acceptance.test.js acceptance/documentation.acceptance.test.mjs",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@trust/extension-sdk": "file:../trust-extension-sdk",
    "@trust/gherkin": "file:../trust-gherkin",
    "@trust/language-server": "file:../trust-language-server",
    "@trust/operation": "file:../trust-operation",
    "@trust/procedure": "file:../trust-procedure",
    "awilix": "^13.0.5",
    "express": "^4.21.2",
    "kysely": "^0.29.5",
    "pino": "^10.3.1",
    "ws": "^8.21.3",
    "@electric-sql/pglite": "0.5.8",
    "pg": "8.23.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0",
    "@types/pg": "^8.23.1"
  }
}
