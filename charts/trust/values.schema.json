{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TRUST Helm values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "webPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "stateDirectory": {
              "type": "string",
              "minLength": 1
            },
            "semanticAuthority": {
              "type": "string",
              "minLength": 1
            },
            "operationsDirectory": {
              "type": "string",
              "minLength": 1
            },
            "extensionsFile": {
              "type": "string",
              "minLength": 1
            },
            "sessionDurationMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "trialTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "extensionTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "runnerTrialScript": {
              "type": "string",
              "minLength": 1
            },
            "diagnosticsEndpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "pglite",
                "postgresql"
              ]
            },
            "directory": {
              "type": "string",
              "minLength": 1
            },
            "connectionString": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": {
              "enum": [
                "local",
                "development",
                "shared"
              ]
            },
            "access": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "const": "local"
                    }
                  },
                  "required": [
                    "mode"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "issuer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "audience": {
                      "type": "string",
                      "minLength": 1
                    },
                    "discovery": {
                      "enum": [
                        "oidc",
                        "oauth"
                      ]
                    },
                    "clockToleranceSeconds": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 60
                    },
                    "maxTokenAgeSeconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 86400
                    },
                    "timeoutMs": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 30000
                    },
                    "allowInsecureLoopback": {
                      "type": "boolean"
                    },
                    "mode": {
                      "const": "local-jwt"
                    },
                    "algorithms": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "enum": [
                          "RS256",
                          "RS384",
                          "RS512",
                          "PS256",
                          "PS384",
                          "PS512",
                          "ES256",
                          "ES384",
                          "ES512",
                          "EdDSA"
                        ]
                      }
                    },
                    "tokenProfile": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "headerType": {
                          "type": "string",
                          "minLength": 1
                        },
                        "requiredClaims": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "headerType"
                      ]
                    }
                  },
                  "required": [
                    "mode",
                    "issuer",
                    "audience"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "issuer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "audience": {
                      "type": "string",
                      "minLength": 1
                    },
                    "discovery": {
                      "enum": [
                        "oidc",
                        "oauth"
                      ]
                    },
                    "clockToleranceSeconds": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 60
                    },
                    "maxTokenAgeSeconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 86400
                    },
                    "timeoutMs": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 30000
                    },
                    "allowInsecureLoopback": {
                      "type": "boolean"
                    },
                    "mode": {
                      "const": "introspection"
                    },
                    "introspection": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "clientId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "clientSecretReference": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "environment": {
                              "type": "string",
                              "minLength": 1
                            },
                            "name": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "environment",
                            "name"
                          ]
                        },
                        "authenticationMethod": {
                          "enum": [
                            "client_secret_basic",
                            "client_secret_post"
                          ]
                        }
                      },
                      "required": [
                        "clientId",
                        "clientSecretReference"
                      ]
                    }
                  },
                  "required": [
                    "mode",
                    "issuer",
                    "audience"
                  ]
                }
              ]
            },
            "browser": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "issuer": {
                  "type": "string",
                  "minLength": 1
                },
                "clientId": {
                  "type": "string",
                  "minLength": 1
                },
                "redirectUri": {
                  "type": "string",
                  "minLength": 1
                },
                "postLogoutRedirectUri": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "resource": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "issuer",
                "clientId",
                "redirectUri",
                "postLogoutRedirectUri",
                "scope"
              ]
            },
            "resourceUrl": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "logging": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "enum": [
                "fatal",
                "error",
                "warn",
                "info",
                "debug",
                "trace",
                "silent"
              ]
            },
            "runtimePath": {
              "type": "string",
              "minLength": 1
            },
            "runnerPath": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rpcEndpoint": {
              "type": "string",
              "minLength": 1
            },
            "otlpEndpoint": {
              "type": "string",
              "minLength": 1
            },
            "authFile": {
              "type": "string",
              "minLength": 1
            },
            "shellTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "additionalPath": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "shell": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "installRoot": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "webAccessPassword": {
              "type": "string",
              "minLength": 1
            },
            "mobileUpstreams": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pathMode": {
                    "enum": [
                      "strip",
                      "preserve"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "secretEnvironment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "secretName": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "secretName",
          "key"
        ]
      }
    },
    "configurationMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 63
          },
          "kind": {
            "enum": [
              "ConfigMap",
              "Secret"
            ]
          },
          "resourceName": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "kind",
          "resourceName"
        ]
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod"
            ]
          }
        },
        "retain": {
          "type": "boolean"
        }
      },
      "required": [
        "existingClaim",
        "size",
        "accessModes",
        "retain"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "LoadBalancer",
            "NodePort"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "type",
        "port"
      ]
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": {
                "type": "string",
                "minLength": 1
              },
              "hosts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "secretName",
              "hosts"
            ]
          }
        }
      },
      "required": [
        "enabled",
        "className",
        "annotations",
        "host",
        "tls"
      ]
    },
    "resources": {
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 600
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    }
  },
  "required": [
    "image",
    "imagePullSecrets",
    "nameOverride",
    "fullnameOverride",
    "replicaCount",
    "config",
    "environment",
    "secretEnvironment",
    "configurationMounts",
    "persistence",
    "service",
    "ingress",
    "resources",
    "terminationGracePeriodSeconds",
    "nodeSelector",
    "tolerations",
    "affinity"
  ]
}
