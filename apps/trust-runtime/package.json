{
  "name": "@trust/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "prebuild": "npm run build --workspace=@trust/procedure",
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:acceptance": "npm run build && node --test dist/acceptance/*.acceptance.test.js",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@trust/operation": "file:../../packages/trust-operation",
    "@trust/procedure": "file:../../packages/trust-procedure",
    "@cucumber/gherkin": "^41.0.0",
    "@cucumber/messages": "^31.0.0",
    "awilix": "^13.0.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2"
  }
}
